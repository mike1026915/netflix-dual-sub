{
  "manifest_version": 3,
  "name": "Netflix Dual Subtitles",
  "version": "1.1",
  "permissions": ["storage"],
  "action": { "default_popup": "popup.html" },
  "content_scripts": [
    { "matches": ["https://www.netflix.com/*"], "js": ["bridge.js"], "run_at": "document_start" },
    { "matches": ["https://www.netflix.com/*"], "js": ["inject.js"], "run_at": "document_start", "world": "MAIN" }
  ]
}
